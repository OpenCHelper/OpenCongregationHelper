# Only the endpoint is served: not the deployer class, nor the tokens uploaded through FTP.
<IfModule mod_authz_core.c>
    Require all denied

    <Files "index.php">
        Require all granted
    </Files>
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all

    <Files "index.php">
        Allow from all
    </Files>
</IfModule>
