# Router of a space hosting several environments, each in its own folder. Generated by the `ftp-archive-deploy`
# action (with `manage-router: true`): changes made here are overwritten by the next deployment.
#
{{PREVIEWS_SUMMARY}}
#  - `<name>.{{SITE}}`        => `<name>/{{DOCUMENT_ROOT}}` (an environment is added with a folder);
#  - `{{SITE}}` and `www.`    => {{DEFAULT_DESCRIPTION}}.
#
# The requests go straight to the document root of each environment (`{{DOCUMENT_ROOT}}`), never through the other
# folders of the application: `/app` must not reach the `app/` folder of the source code. A missing folder is a 404.
#
# Shared hostings like Altervista reject some directives in `.htaccess` files (e.g. `Header`), failing every request
# with an error 500: add only the ones they allow.
{{PHP_HANDLER}}
Options -Indexes

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    Options +FollowSymLinks

    RewriteEngine On

    # The deployer of the action (one folder per version)
    RewriteRule ^_deployer/[0-9a-f]{12}/(index\.php)?$ - [L]

    # Already routed to an environment folder that has no `.htaccess` handling the request (e.g. a missing one):
    # stop here, instead of routing it again
    RewriteCond %{ENV:REDIRECT_STATUS} .
    RewriteRule ^ - [L]

{{PREVIEWS_RULE}}
    # <name>.{{SITE}} => the document root of the environment
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteCond %{HTTP_HOST} ^([a-z0-9-]+)\.{{SITE_PATTERN}}(:[0-9]+)?$ [NC]
    RewriteRule ^(.*)$ %1/{{DOCUMENT_ROOT}}$1 [L]

    # {{SITE}} and www.{{SITE}}
    {{DEFAULT_RULE}}
</IfModule>

# Without mod_rewrite the rules above do nothing and every file would be served: deny everything.
<IfModule !mod_rewrite.c>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</IfModule>
