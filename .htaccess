# Set default PHP version to 8.2 (http://it.help.altervista.org/w/Configurazione_personalizzata_(.htaccess)#Direttive_disponibili_nei_file_.htaccess)
# # av:php5-engine
AddHandler av-php82 .php

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    Options +FollowSymLinks
    
    # Activate the mod_rewrite engine
    RewriteEngine On
    RewriteBase /
    
    # Redirect all traffic to public folder
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Without mod_rewrite the rule above does nothing and the whole project
# (`.env`, `storage/`, ...) would be served as static files: deny everything.
<IfModule !mod_rewrite.c>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</IfModule>
