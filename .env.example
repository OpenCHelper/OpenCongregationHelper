APP_NAME="My Application Name"
APP_ENV=production                      # Set to `local` for development
APP_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # Generate a new key with `php artisan key:generate`
APP_DEBUG=false                         # Set to `true` for development (never in production)
APP_TIMEZONE=UTC
APP_URL=http://localhost/               # Set to your application base URL
ASSET_URL=http://localhost/             # Set to endpoint serving your assets

# The following are variables used to customize the retrieval of version information.
# Leave them empty (or omit them) to get the default behaviour (values taken from the `.git` folder)
APP_VERSION_BRANCH_FILE=                # Set to specify a file where the git branch is stored (default=.git/HEAD)
APP_VERSION_COMMIT_FILE=                # Set to specify a file where the git commit is stored (default=.git/refs/heads/{branch})

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

ARTISAN_CRON_TOKEN=                     # Secret sent as `X-Cron-Token` header to the queue/schedule endpoints (empty = endpoints disabled)
ENABLE_SHARED_PII=false                 # Show personal data (assignee name, notes) on publicly shared pages
PHP_CLI_SERVER_WORKERS=1                # Fix for PHP's built-in server crashing on Windows

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                       # Set to `debug` for development

DB_CONNECTION=mysql
DB_HOST="localhost"                       # Set to your database hostname (usually `localhost`)
DB_PORT=3306
DB_DATABASE="my_database_name"            # Set to your database name
DB_USERNAME="my_database_username"        # Set to your database username
DB_PASSWORD="my_database_password"        # Set to your database password
DB_ROOT_PASSWORD="my_database_password"   # Set to your database root password
DB_ENGINE="InnoDB"
DB_PREFIX=""                              # Set to your database table prefix (optional)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION="database"               # Use `QUEUE_CONNECTION=sync` for local development

CACHE_STORE="database"                    # Use `CACHE_STORE=array` for local development
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Where the maps open when they have nothing to show yet (e.g. a new territory): the area of the congregation, as
# "latitude,longitude". Rome (Italy) when not set.
#MAP_DEFAULT_CENTER="41.896961975616,12.481241781767"

INITIAL_ROOT_USERNAME="Root User"
INITIAL_ROOT_USERMAIL="root@example.com"
INITIAL_ROOT_PASSWORD="MyVerySecretPassword"

# Demo installations only (e.g. PR previews), with dummy data: pre-fill the login page with the credentials of the
# root user above, so that anyone can log in as root. Ignored in production.
DEMO_PREFILL_LOGIN_CREDENTIALS=false
