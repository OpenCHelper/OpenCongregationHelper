// https://aka.ms/devcontainer.json
{
    "name": "Registro Territori",
    "dockerComposeFile": [
        "../docker-compose.yml"
    ],
    "service": "laravel.test",
    "workspaceFolder": "/var/www/html",
    "customizations": {
        "vscode": {
            "extensions": [
                "mikestead.dotenv",
                "laravel.vscode-laravel",
                "amiralizadeh9480.laravel-extra-intellisense",
                "ryannaddy.laravel-artisan",
                "onecentlin.laravel-blade",
                "usernamehw.errorlens",
                "bpruitt-goddard.mermaid-markdown-syntax-highlighting",
                "yzhang.markdown-all-in-one",
                "DavidAnson.vscode-markdownlint",
                "bmewburn.vscode-intelephense-client",
                "timonwong.shellcheck",
                "github.vscode-github-actions",
                "cjhowe7.laravel-blade",
                "foxundermoon.shell-format",
                "IronGeek.vscode-env",
                "EditorConfig.EditorConfig"
            ],
            "settings": {}
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/github-cli:1.1.2": {},
        "ghcr.io/devcontainers/features/docker-in-docker:4.1.0": {},
        "ghcr.io/devcontainers-extra/features/act:1": {},
        "ghcr.io/devcontainers-extra/features/actionlint:1": {}
    },
    "remoteUser": "sail",
    "postCreateCommand": {
        "fixPermissions": "chown -R 1000:1000 /var/www/html 2>/dev/null || true",
        "setupBashrc": "echo \"alias artisan='php artisan'\" >> ~/.bashrc"
    },
    // Forward these ports automatically
    "forwardPorts": [
        80,
        "phpmyadmin:80",
        "mailpit:80"
    ],
    "otherPortsAttributes": {
        // Default behavior for unlisted ports
        "onAutoForward": "notify"
    },
    // Stop the containers when the dev container is closed
    "shutdownAction": "stopCompose"
}